# Copy to server/.env and adjust before the first production start.
# systemd: EnvironmentFile=/path/to/server/.env
# or:     node --env-file=.env dist/index.js
# Never commit the real .env: it is ignored, this template is not.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# SQLite lives on the VPS; image bytes never do.
DB_PATH=./data/boorushiko.db
STAGING_DIR=/dev/shm/boorushiko

# Public origin used by sitemap.xml, robots.txt and absolute links.
PUBLIC_BASE_URL=https://your-domain.example

# Trust X-Forwarded-For only from the local reverse proxy.
# Use the proxy address, a CIDR, or `true` when Caddy runs on another host.
TRUST_PROXY=loopback

# Perimeter. Rate limits are on by default in production; 0 is for debugging only.
RATE_LIMIT_ENABLED=1
# JSON/form body cap. Multipart uploads use MAX_UPLOAD_BYTES instead.
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=20000

# Structured JSON logs: one object per line, warn/error also go to stderr.
LOG_LEVEL=info
LOG_REQUESTS=1

# SQLite snapshots (VACUUM INTO). Leave room for BACKUP_KEEP copies and point an
# offsite job (rclone/rsync) at this directory.
BACKUP_ENABLED=1
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=3
# Weekly wal_checkpoint(TRUNCATE) + VACUUM; 0 disables.
MAINTENANCE_VACUUM_DAYS=7

# Health checks and alerts. Without the Telegram pair alerts go to the JSON log.
MONITOR_ENABLED=1
MONITOR_INTERVAL_MINUTES=5
MONITOR_DISK_MIN_MB=512
MONITOR_QUEUE_MAX=500
MONITOR_RSS_MAX_MB=400
ALERT_COOLDOWN_MINUTES=60
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Mirrors for hosted posts: catbox (no key, undocumented form API), imgbb
# (key, 32 MB), yourimageshare (key, documented JSON API, 100 MB per request).
MIRRORS=catbox,imgbb
IMGBB_KEY=
YOURIMAGESHARE_KEY=
MIN_MIRRORS=2

# Generate with: openssl rand -hex 32
UPLOAD_TOKEN=change-me

# RFC 9116 contact. SECURITY_EXPIRES is optional (default: 364 days from startup).
SECURITY_CONTACT=mailto:security@your-domain.example

# Origins allowed to read the public API from a browser. `*` allows any; empty disables CORS.
# Session endpoints (/api/v1/admin, /auth, /me) never receive CORS headers.
API_CORS_ORIGINS=*

MAX_UPLOAD_BYTES=33554432
STAGING_TTL_MINUTES=60
JOBS_INTERVAL_MS=5000
SESSION_TTL_DAYS=30
COOKIE_SECURE=1

COMMENT_COOLDOWN_SECONDS=5
COMMENT_HIDE_SCORE=-5
COMMENT_HIDE_MIN_VOTES=5
COMMENT_VOTE_COOLDOWN_SECONDS=1
COMMENT_VOTE_DAILY_LIMIT=50
COMMENT_MOD_VOTE_WEIGHT=3
COMMENT_MUTUAL_DOWNVOTE_HOURS=24

# Tags hidden from galleries and post pages until a visitor opts in under /settings.
# Comma-separated wildcards; empty uses the built-in list (loli*, shota*, rape*, guro*, …),
# `none` disables filtering entirely.
SENSITIVE_TAGS=

REMOTE_THUMB_CACHE_MB=128
REMOTE_THUMB_MAX_BYTES=8388608
REMOTE_THUMB_TIMEOUT_MS=8000

# Gelbooru gates its DAPI per account; set both or the source answers 401.
# Values live on https://gelbooru.com/index.php?page=account&s=options
GELBOORU_API_KEY=
GELBOORU_USER_ID=

SOURCE_AUTO_ENABLED=1
SOURCE_AUTO_INTERVAL_MINUTES=30
SOURCE_AUTO_BATCH=20
SOURCE_AUTO_DAILY_LIMIT=300
# Optional source query, e.g. `rating:g` or `solo rating:s,q`.
SOURCE_AUTO_TAGS=
